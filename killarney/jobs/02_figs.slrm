#!/bin/bash
# Phase 2 — regenerate figures from the phase-1 data, then collect a snapshot into
# killarney/results/. Run AFTER the array job finishes. Submit FROM killarney/:
#     sbatch --dependency=afterok:<ARRAY_JOB_ID> jobs/02_figs.slrm
# (or just `sbatch jobs/02_figs.slrm` once phase 1 is done). Single CPU task.
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=tab_figs
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=0:30:00
#SBATCH --output=logs/%x-%j.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."

module load python/3.12
source "$REPO/venv/bin/activate"
cd "$REPO/python"

export MPLBACKEND=Agg
echo "=== figs on $(hostname) | $(date) ==="

# B/C: headline + peak ablation + calibration table (fig_tabular merges all data/tabular/run_*)
python fig_tabular.py
# C: horizon
python fig_horizon.py
# D: alpha-div sweep (standard) + kln, each run needs its own results.json path
for p in 60 70 80; do
  python fig_adiv.py "data/tabular/run_adiv_p${p}/results.json"
  python fig_adiv.py "data/tabular/run_adiv_p${p}_kln/results.json"
done
python fig_adiv_compare.py       # adiv_compare_p80 (knife-edge vs kln smooth well)
python fig_adiv_invariant.py     # adiv_invariant (std_pi[C_Omega] vs a)
# A: M1/M2 mechanism (self-contained MC; no data run needed)
python fig_mechanism.py
# E: CI (n=10 vs n=100) — NO reproducible generator in the repo yet; see README. Skipped.

# --- collect a distinguishable snapshot into killarney/results/ -------------
STAMP="$(date +%Y%m%d_%H%M%S)"
DEST="$SLURM_SUBMIT_DIR/results/run_${STAMP}"
mkdir -p "$DEST/figs"
cp -f figs/*.png figs/tabular_calibration.* "$DEST/figs/" 2>/dev/null || true
# keep the manifests (hyperparams, seeds, git commit) but not the bulky results.json
for m in data/tabular/*/manifest.json; do
  d="$DEST/manifests/$(basename "$(dirname "$m")")"; mkdir -p "$d"; cp -f "$m" "$d/"
done
echo "collected -> $DEST"
echo "=== done | $(date) ==="
