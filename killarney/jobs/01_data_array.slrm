#!/bin/bash
# Phase 1 — data generation (CPU array job). One array task per active line of
# ../experiments.list. Pure NumPy: NO GPU (no --gres). Submit FROM killarney/:
#     cd ~/projects/aip-rudner/$USER/bregman-lab/killarney
#     sbatch jobs/01_data_array.slrm
# --array upper bound must equal the number of active (non-#, non-blank) lines:
#     grep -cvE '^[[:space:]]*(#|$)' experiments.list      # -> 13
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=tab_data
#SBATCH --gres=gpu:0                 # CPU-only: Killarney has no CPU nodes, so explicitly ask 0 GPUs
#SBATCH --array=1-13
#SBATCH --cpus-per-task=16           # each task parallelizes its MDP blocks over these cores
#SBATCH --mem=16G                    # tabular is small; 16G is ample headroom
#SBATCH --time=8:00:00               # ~8.6 min/block over 16 cores: t2 (200 blocks) ~1.8h; 8h is safe for all
#SBATCH --output=logs/%x-%A_%a.out   # %A=array job id, %a=task index

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."          # submitted from killarney/ -> repo root is ..
export PYTHONUNBUFFERED=1            # stream progress prints to the log live (stdout block-buffers to file)

module load python/3.12
source "$REPO/venv/bin/activate"

# pick this task's command (skip comments/blanks)
CMD="$(grep -vE '^[[:space:]]*(#|$)' "$SLURM_SUBMIT_DIR/experiments.list" | sed -n "${SLURM_ARRAY_TASK_ID}p")"
if [[ -z "$CMD" ]]; then echo "no command for array index ${SLURM_ARRAY_TASK_ID}"; exit 1; fi

echo "=== array ${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID} on $(hostname) | $(date) ==="
echo "CMD: $CMD --jobs ${SLURM_CPUS_PER_TASK}"

cd "$REPO/python"
eval "$CMD --jobs ${SLURM_CPUS_PER_TASK}"     # data lands in python/data/tabular/run_*/
echo "=== done | $(date) ==="
