#!/bin/bash
# 4B seed replication — seeds 1 and 2 for all six divergences x {amari, canon}, taking every 4B cell
# from n=1 to n=3.
#
# WHY. Every Arena-judged amari-vs-canonical result in the project is a single run at seed 0, and 4B
# is where that hurts most: the canonical advantage there averages only 2.9 points (Amari win rate
# 47.1%) and three of the five judged divergences have a 95% CI that includes 50%. With one seed we
# cannot tell a real 3-point effect from seed noise. (The existing 3-seed sweep in the repo is a
# different setup -- SFT'd UltraChat reference, conventional generator only, no Arena judging -- so
# it does not cover this.)
#
# The recipe is byte-identical to jobs/stage_b_normcmp_arena.slrm (which produced seed 0) except --seed
# and --out. Same h100:1, same 20h: seed 0 measured 14.3h wall on one GPU. Deliberately NOT the 2-GPU
# FSDP variant, even though it would finish in ~10h and reach a better walltime tier -- sharding
# changes reduction order, which would add a second difference between the seeds.
#
# --norm is passed explicitly for every arm. That is safe: norm_shift() gives the same constant for
# "natural" and "amari" on adiv/js/hel/chi2, and for "natural" and "canon" on RKL, so these arms are
# numerically what seed 0 ran even where seed 0 relied on the default.
#
# Submit FROM llm/:  sbatch jobs/stage_b_seeds_17b.slrm
# Out: $OUT_DIR/stageB_scale4b_{div}_{norm}_bdpo_token_s{1,2}   (+ _policy, ~8 GB each; 24 x 8 = 192 GB)
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=sd17b
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=0-23%6
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=20:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"
OUT_DIR="/scratch/$USER/bregman-lab/llm/results/bench"; mkdir -p "$OUT_DIR"   # never /project (quota)

SPECS=(kl:amari kl:canon adiv:amari adiv:canon js:amari js:canon hel:amari hel:canon chi2:amari chi2:canon rkl:amari rkl:canon)
I=$((SLURM_ARRAY_TASK_ID % 12)); SEED=$((1 + SLURM_ARRAY_TASK_ID / 12))
SPEC="${SPECS[$I]}"; DIV="${SPEC%:*}"; NORM="${SPEC#*:}"

echo "=== bench-1.7B [$DIV, norm=$NORM, seed=$SEED] full-FT (2ep) on $(hostname) | $(date) ==="; nvidia-smi
python stage_b_train.py \
  --ref Qwen/Qwen3-1.7B-Base --policy Qwen/Qwen3-1.7B-Base --init-noise 0.01 \
  --data data/uf_pairs_train_full.jsonl --eval-data data/uf_pairs_test.jsonl \
  --div "$DIV" --norm "$NORM" --inner sample --step-mode token \
  --beta 0.1 --lr 5e-6 --lr-schedule linear --warmup-ratio 0.05 --weight-decay 0.01 --adam-beta2 0.999 \
  --epochs 2 --grad-accum 64 --grad-clip 1.0 --max-len 1024 --clamp 15 \
  --eval-n 256 --log-every 5 --eval-every 25 --seed "$SEED" --save-policy \
  --out "$OUT_DIR/stageB_${DIV}_${NORM}_bdpo_token_bench1p7b_s${SEED}"
echo "=== done bench-1.7B [$DIV, norm=$NORM, seed=$SEED] | $(date) ==="
