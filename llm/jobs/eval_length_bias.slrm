#!/bin/bash
# Stage B — length-bias probe (Goal 1): forward-only per-pair eval of the SAVED newline single-sample
# policies, dumping (S_w,S_l,K_w,K_l) so the local fig_length_bias.py can inject TRL's per-step length
# term β·f'(1)·ΔK and show TRL's RKL/FKL accuracy change is manufactured by (K_w−K_l).
#
# No training — two frozen forward passes (policy+ref) over the 1000-pair UF test split, a few min each.
# Array 1-2 = kl (RKL, f'(1)=+1 → +ΔK helps) and rkl (FKL, f'(1)=−1 → −ΔK hurts): the two f'(1)≠0
# admissible cases where TRL = single + β·f'(1)·K exactly. Non-adm (js/hel/adiv/chi2) have f'(1)=0
# (no length term) so they need no probe.
#
# Needs the matching saved policies:
#   matched : results/stageB_{kl,rkl}_newline_match1p7b_policy  ref=results/sft_uc_1p7b_model  (ALREADY
#             saved by stage_b_seg.slrm — note the FLAT path: the recipe reorg into results/matched/ was
#             local-only, so on the cluster the policies stayed at the original flat write path.)
#   light   : results/sft1p7b/stageB_{kl,rkl}_newline_light1p7b_policy  ref=Qwen/Qwen3-1.7B-Base
#             (NOT saved originally — make with jobs/stage_b_lenbias_save.slrm first.)
# Submit with the SAME RECIPE used to train. FROM llm/:
#   sbatch jobs/eval_length_bias.slrm                          # matched (default, no retrain needed)
#   sbatch --export=ALL,RECIPE=light   jobs/eval_length_bias.slrm   # after the light save job
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=stageBlenbias
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=1-2
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=1:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

RECIPE="${RECIPE:-matched}"               # matched (default, policies already saved) | light
DIVS=(kl rkl)                             # kl=RKL (+ΔK helps), rkl=FKL (−ΔK hurts)
DIV="${DIVS[$((SLURM_ARRAY_TASK_ID - 1))]}"

if [ "$RECIPE" = "matched" ]; then        # FLAT policy path (see header) — NOT results/matched/
  POL="results/stageB_${DIV}_newline_match1p7b_policy"; REF="results/sft_uc_1p7b_model"
  MAXLEN=1024; TAG="match1p7b"
else
  POL="results/sft1p7b/stageB_${DIV}_newline_light1p7b_policy";  REF="Qwen/Qwen3-1.7B-Base"
  MAXLEN=768;  TAG="light1p7b"
fi

echo "=== length-bias probe RECIPE=$RECIPE div=$DIV pol=$POL on $(hostname) | $(date) ==="; nvidia-smi

# forward-only; MUST match the trainer's newline recipe knobs (clamp 15, matching --max-len, beta 0.1)
python eval_length_bias.py \
  --policy "$POL" --ref "$REF" \
  --div "$DIV" --eval-data data/uf_pairs_test.jsonl \
  --beta 0.1 --clamp 15 --max-len "$MAXLEN" \
  --out "results/lenbias/stageB_${DIV}_newline_${TAG}_perpair"

echo "=== done length-bias probe RECIPE=$RECIPE div=$DIV | $(date) ==="
