#!/bin/bash
# Cross-family LoRA — RKL, Amari vs canonical, seeds 0/1/2, on the INSTRUCT variants.
#
# WHY INSTRUCT AND NOT BASE. The first attempt at this axis used the base checkpoints and had to be
# thrown away: Llama-3.2-1B answers Arena-Hard prompts in 30-45 tokens and opens a fabricated
# "\n\nHuman:" turn on 273/500, and gemma-3-1b-pt degenerates into "Assistant: Assistant: ...".
# Qwen3-*-Base only looked comparable because it is not really a base model -- it ships the full
# instruct chat template and follows instructions. The Instruct variants were then verified
# untrained, and both are usable:
#     Llama-3.2-1B-Instruct   median 574 tok,  9.6% at 1024-cap  (588 / 3.2% at 2048)
#     gemma-3-1b-it           median 1024 tok, 62.4% at cap      (1157 / 2.4% at 2048)
# Gemma is merely verbose, not broken: doubling the cap moves its median only 13% and 97.6% then
# terminate on their own. That is why generation for this axis is at --max-new 2048.
#
# WHY THIS AXIS. Vocabulary size is the thing being varied, since the inner-term gap is predicted to
# grow with |V|:  Llama 128k  <  Qwen3 152k  <  Gemma 262k.
#
# WHY LoRA ON L40S. The earlier base-model script asked for an h100 because stage_b_train.py holds
# fp32 [T,|V|] logits for BOTH policy and reference -- 1.07 GB each at Gemma's 262k vocab. Under LoRA
# there is no separate reference (the adapter is disabled instead), which removes a full model copy
# and lets these fit an L40S comfortably. It also keeps them off the h100 queue, where 4B work has
# been stuck for days.
#
# Config matches stage_b_lora_8b_l40s.slrm apart from the model: r=alpha=128, dropout 0.05, all seven
# linear projections, checkpointing on, lr 5e-6, 2 epochs.
#
#   array index: 0-5 llama, 6-11 gemma; within each, seed = (i%6)/2 and norm = i%2 (0 amari, 1 canon)
# Out: $OUT_DIR/stageB_lora{llama1b,gemma1b}_kl_{amari,canon}_bdpo_token_s{0,1,2}
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=lorafam
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=0-11%3
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=23:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"
OUT_DIR="/scratch/$USER/bregman-lab/llm/results/bench"; mkdir -p "$OUT_DIR"

I=$SLURM_ARRAY_TASK_ID
if [ "$I" -lt 6 ]; then M="meta-llama/Llama-3.2-1B-Instruct"; FAM=llama1b; else M="google/gemma-3-1b-it"; FAM=gemma1b; fi
J=$((I % 6)); SEED=$((J / 2)); NORMS=(amari canon); NORM="${NORMS[$((J % 2))]}"; DIV=kl

echo "=== family LoRA [$FAM, $DIV, norm=$NORM, seed=$SEED] 1xL40S (2ep) on $(hostname) | $(date) ==="; nvidia-smi
python stage_b_train.py \
  --ref "$M" --policy "$M" --init-noise 0.01 \
  --lora-r 128 --lora-alpha 128 --lora-dropout 0.05 --save-adapter-every 200 \
  --data data/uf_pairs_train_full.jsonl --eval-data data/uf_pairs_test.jsonl \
  --div "$DIV" --norm "$NORM" --inner sample --step-mode token \
  --beta 0.1 --lr 5e-6 --lr-schedule linear --warmup-ratio 0.05 --weight-decay 0.01 --adam-beta2 0.999 \
  --epochs 2 --grad-accum 64 --grad-clip 1.0 --max-len 1024 --clamp 15 \
  --eval-n 256 --log-every 25 --eval-every 100 --seed "$SEED" --save-policy \
  --out "$OUT_DIR/stageB_lora${FAM}_${DIV}_${NORM}_bdpo_token_s${SEED}"
echo "=== done family LoRA [$FAM, $DIV, norm=$NORM, seed=$SEED] | $(date) ==="
