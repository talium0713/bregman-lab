#!/bin/bash
# Stage B — the OTHER row of the (batch × lr) grid: FIXED lr=5e-5 (matched's lr), sweep the two missing
# batches b8 and b64. Combined with matched b512 (lr5e-5, results/matched) this gives a clean lr=5e-5
# batch axis {8,64,512}. Together with the lr=5e-6 row (results/lrfix b8/b512 + results/mid b64) it
# fills the full 2D grid, answering: is kln's jagged/harmful behavior a HIGH-LR effect at every batch,
# or only at b512? (At lr5e-6 kln was consistent across batch; this tests whether lr5e-5 breaks it
# everywhere.)
#
# = matched recipe (UC-SFT ref/policy, +init-noise .01, UF-full, 2 ep, clamp 15, max-len 1024,
# grad-clip 1.0, linear lr + warmup .05, wd .01, β2 .999, lr 5e-5), only --grad-accum (batch) varies.
# Caveat: b8 @ lr5e-5 is a very high lr for batch 8 (50× the light-recipe lr) → expect instability /
# some non-finite-loss skips (grad-clip 1.0 guards; the trainer skips non-finite pairs). That (in)stability
# is itself the datapoint.
#
# 8 configs = {b8,b64}×{token,newline}×{no-kln,kln}, ×6 div = 48 tasks (config outer, div inner):
#   b8_token 1-6 · b8_token_kln 7-12 · b8_newline 13-18 · b8_newline_kln 19-24 ·
#   b64_token 25-30 · b64_token_kln 31-36 · b64_newline 37-42 · b64_newline_kln 43-48
# Submit FROM llm/:  sbatch jobs/stage_b_hilr.slrm   |  b8 only: sbatch --array=1-24 …
# Output: results/hilr/stageB_{div}_{label}_hilr1p7b
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=stageBhilr
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=1-48
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=20:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

CONFIGS=(
  "b8_token:8:--step-mode token --inner sample"
  "b8_token_kln:8:--step-mode token --inner sample --kln"
  "b8_newline:8:--step-mode newline --inner sample"
  "b8_newline_kln:8:--step-mode newline --inner sample --kln"
  "b64_token:64:--step-mode token --inner sample"
  "b64_token_kln:64:--step-mode token --inner sample --kln"
  "b64_newline:64:--step-mode newline --inner sample"
  "b64_newline_kln:64:--step-mode newline --inner sample --kln"
)
DIVS=(kl adiv rkl js hel chi2)
ND=${#DIVS[@]}
i=$((SLURM_ARRAY_TASK_ID - 1))
CFG="${CONFIGS[$((i / ND))]}"; DIV="${DIVS[$((i % ND))]}"
LABEL="${CFG%%:*}"; rest="${CFG#*:}"; BATCH="${rest%%:*}"; FLAGS="${rest#*:}"

# per-batch eval/log cadence (b8 ~15.3k steps, b64 ~1.9k steps)
if [ "$BATCH" -le 8 ]; then EVAL_EVERY=200; LOG_EVERY=50; else EVAL_EVERY=25; LOG_EVERY=5; fi

echo "=== Stage B hilr Ω=$DIV cfg=$LABEL (batch=$BATCH lr=5e-5 $FLAGS) on $(hostname) | $(date) ==="; nvidia-smi
nvidia-smi --query-gpu=timestamp,utilization.gpu,memory.used --format=csv,noheader -l 30 \
  > "logs/gpu-${SLURM_JOB_ID}.csv" 2>/dev/null &
SMI_PID=$!

# = matched recipe, lr FIXED 5e-5, only --grad-accum (batch) varies.
python stage_b_train.py \
  --ref results/sft_uc_1p7b_model --policy results/sft_uc_1p7b_model --init-noise 0.01 \
  --data data/uf_pairs_train_full.jsonl --eval-data data/uf_pairs_test.jsonl \
  --div "$DIV" $FLAGS \
  --beta 0.1 --lr 5e-5 --lr-schedule linear --warmup-ratio 0.05 --weight-decay 0.01 --adam-beta2 0.999 \
  --epochs 2 --grad-accum "$BATCH" --grad-clip 1.0 --max-len 1024 --clamp 15 \
  --eval-n 256 --log-every "$LOG_EVERY" --eval-every "$EVAL_EVERY" --seed 0 \
  --out "results/hilr/stageB_${DIV}_${LABEL}_hilr1p7b"

kill "$SMI_PID" 2>/dev/null || true
echo "=== done hilr div=$DIV cfg=$LABEL | $(date) ==="
