#!/bin/bash
# Stage B — token-level f-DPO training, 1.7B pilot. One array task per (divergence, inner-arm)
# combination: 6 f-divs × {sample, exact} + euc(exact only) = 13 runs. Trains the policy from the
# frozen base; RKL is the correctness anchor (both arms == standard DPO).
#
# Submit FROM llm/ (after prefetch + scp of data/uf_pairs_{train,test}.jsonl):
#     sbatch jobs/stage_b.slrm
# Smoke-test one arm interactively first:
#     srun --account=aip-rudner --gres=gpu:l40s:1 --mem=48G -c 8 --time=1:00:00 --pty bash
#     python stage_b_train.py --div kl --inner sample --steps 30 --out results/smoke
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=stageB
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=1-13
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=6:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

# (divergence, inner-arm) grid — euc has no single-sample inner term, so exact only.
DIVS=(kl   kl    adiv adiv  rkl  rkl   js   js    hel  hel   chi2 chi2  euc)
ARMS=(sample exact sample exact sample exact sample exact sample exact sample exact exact)
i=$((SLURM_ARRAY_TASK_ID - 1))
DIV="${DIVS[$i]}"; ARM="${ARMS[$i]}"
declare -A SHOW=([kl]=RKL [adiv]="α-div" [rkl]=FKL [js]=JS [hel]=Hel [chi2]="χ²" [euc]=Euc)   # key->display (kl=reverse-KL, rkl=forward-KL)

echo "=== Stage B  Ω=${SHOW[$DIV]} (key $DIV)  inner=$ARM  on $(hostname) | $(date) ==="; nvidia-smi

python stage_b_train.py \
  --ref Qwen/Qwen3-1.7B-Base \
  --data data/uf_pairs_train.jsonl \
  --div "$DIV" --inner "$ARM" \
  --beta 0.1 --lr 5e-7 --steps 1000 --grad-accum 8 --max-len 768 --clamp 15 \
  --eval-n 128 --seed 0 \
  --out "results/stageB_${DIV}_${ARM}_1p7b"

echo "=== done  div=$DIV  inner=$ARM | $(date) ==="
