#!/bin/bash
# Sanity/validation: generate Qwen3-1.7B-Base responses on ALL 3 benchmarks to check our pipeline
# reproduces the paper's "Base" row (AlpacaEval2 LC~8.3/WR~6.0, MT-Bench GPT-4.1~5.1). Arena-Hard here
# is v2 (per current choice) — Base will be low there (v2 is frontier-scale), that's expected.
#   task 0 = AlpacaEval (805, alpaca fmt, 512 tok, batched)
#   task 1 = Arena-Hard v2 (750, arenav2 fmt, 2048 tok, batched)
#   task 2 = MT-Bench (80×2-turn, fastchat fmt, 1024 tok, sequential)
# Needs data/{alpaca_eval,arena_hard_v2,mt_bench}.jsonl. Submit FROM llm/:
#   sbatch --exclude=kn010,kn001 jobs/gen_bench_base.slrm
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=genbase
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=0-2
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=6:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

MODEL="Qwen/Qwen3-1.7B-Base"; TAG="Qwen3-1.7B-Base"
case "$SLURM_ARRAY_TASK_ID" in
  0) SET=data/alpaca_eval.jsonl;  FMT=alpaca;   MAXNEW=512;  OUT=results/bench/base_alpaca.json ;;
  1) SET=data/arena_hard_v2.jsonl; FMT=arenav2; MAXNEW=2048; OUT="results/bench/arena/${TAG}.jsonl" ;;
  2) SET=data/mt_bench.jsonl;     FMT=fastchat; MAXNEW=1024; OUT="results/bench/mtbench/${TAG}.jsonl" ;;
esac

echo "=== gen Base [$FMT] $SET on $(hostname) | $(date) ==="; nvidia-smi
python gen_bench.py --model "$MODEL" --generator "$TAG" --prompts "$SET" \
  --format "$FMT" --max-new "$MAXNEW" --temperature 0.0 --out "$OUT"
echo "=== done Base $FMT -> $OUT | $(date) ==="
