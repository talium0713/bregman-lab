#!/bin/bash
# Arena-Hard v0.1 GENERATION for the 8B LoRA policies (RKL amari vs canon). Generation flags are
# byte-identical to gen_scale4b.slrm so the answers are judgeable against the same baseline. The
# policy directories are ordinary causal-LM dirs: stage_b_train.py calls merge_and_unload() before
# saving under LoRA, so nothing here needs to know an adapter was involved.
#   array index = 0:amari 1:canon
# Output: results/bench/arena_v01/lora8b_kl_{amari,canon}_bdpo.jsonl
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=glora8b
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=0-1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=8:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="${HF_HOME:-/scratch/$USER/hf_cache}"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

NORMS=(amari canon); NORM="${NORMS[$SLURM_ARRAY_TASK_ID]}"; DIV=kl
POL="${OUT_DIR:-/scratch/$USER/bregman-lab/llm/results/bench}/stageB_lora8b_${DIV}_${NORM}_bdpo_token_policy"
TAG="lora8b_${DIV}_${NORM}_bdpo"
[ -d "$POL" ] || { echo "policy $POL missing — train it first"; exit 1; }

echo "=== gen Arena-Hard v0.1 [$TAG] from $POL on $(hostname) | $(date) ==="; nvidia-smi
python gen_bench.py --model "$POL" --generator "$TAG" --prompts data/arena_hard_v01.jsonl \
  --format arenav2 --think default --system "You are a helpful assistant." \
  --rep-penalty 1.05 --max-new 1024 --temperature 0.0 --out "results/bench/arena_v01/${TAG}.jsonl"
echo "=== done $TAG -> results/bench/arena_v01/${TAG}.jsonl | $(date) ==="
