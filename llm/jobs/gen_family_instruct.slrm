#!/bin/bash
# VERIFICATION: can the Instruct variants actually do Arena-Hard, where the base checkpoints could not?
#
# The cross-family axis was cancelled because both true base checkpoints are unusable on this
# benchmark. Measured on the untrained models, 500 prompts each:
#   Llama-3.2-1B      median 45 tok, 21.6% at cap, 273/500 open a fabricated "\n\nHuman:" turn;
#                     answers are 30-45 token non-answers ("I'm not sure what you mean by ...").
#   gemma-3-1b-pt     median 1024 tok, 55.6% at cap, degenerates into "Assistant: Assistant: ...".
# Qwen3-*-Base looked fine only because it is not really a base model: it ships the full instruct
# chat template and follows instructions, so base -> f-DPO was never an equal comparison across
# families.
#
# This job generates from the UNTRAINED Instruct variants. No training is spent until we can see
# that the starting point produces real answers. The numbers to read are the same three: median
# length, at-cap rate, and whether answers are on-topic. If these look like Qwen3-*-Base (median
# ~500, at-cap ~10%), the axis is viable with Instruct as the starting point.
#
#   array index = 0 Llama-3.2-1B-Instruct, 1 gemma-3-1b-it
# Output: results/bench/arena_v01/{llama1b,gemma1b}_instruct_base.jsonl
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=ginstr
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=0-1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=6:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

MODELS=(meta-llama/Llama-3.2-1B-Instruct google/gemma-3-1b-it)
TAGS=(llama1b_instruct_base gemma1b_instruct_base)
M="${MODELS[$SLURM_ARRAY_TASK_ID]}"; TAG="${TAGS[$SLURM_ARRAY_TASK_ID]}"
# MAX_NEW/SUF let the same script run the 2048 termination diagnostic:
#   MAX_NEW=2048 SUF=_mn2048 sbatch --export=ALL,MAX_NEW,SUF --array=1 jobs/gen_family_instruct.slrm

echo "=== gen Arena-Hard v0.1 [$TAG] from $M on $(hostname) | $(date) ==="; nvidia-smi
python gen_bench.py --model "$M" --generator "$TAG" --prompts data/arena_hard_v01.jsonl \
  --format arenav2 --think default --system "You are a helpful assistant." \
  --rep-penalty 1.05 --max-new "${MAX_NEW:-1024}" --temperature 0.0 --out "results/bench/arena_v01/${TAG}${SUF:-}.jsonl"
echo "=== done $TAG | $(date) ==="
