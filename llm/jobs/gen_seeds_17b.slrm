#!/bin/bash
# Arena-Hard v0.1 generation for the 1.7B seed-replication policies.
#
# Flags are byte-identical to gen_normcmp_arena.slrm, which produced the seed-0 answers, so the new
# seeds are judgeable against the same baseline and comparable to the existing seed-0 numbers. In
# particular --max-new 1024: at 1.7B nothing truncates pathologically (every arm sits at 8-13% at
# cap, the untrained base at 11.6%), and the 2048 diagnostic confirmed medians hold there, so 1024
# is the right cap and changing it would break comparability with seed 0.
#
# SEED is an env override. Seed 1 is complete (12/12) as of 2026-09-17; seed 2 is still training.
#   SEED=2 sbatch --export=ALL,SEED jobs/gen_seeds_17b.slrm
#
#   array index = (kl|rkl|adiv|js|hel|chi2) x (amari|canon)
# Output: results/bench/arena_v01/{div}_{norm}_bdpo_s{SEED}.jsonl
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=gsd17b
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=0-11%4
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=6:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

SEED="${SEED:-1}"
SPECS=(kl:amari kl:canon rkl:amari rkl:canon adiv:amari adiv:canon js:amari js:canon hel:amari hel:canon chi2:amari chi2:canon)
SPEC="${SPECS[$SLURM_ARRAY_TASK_ID]}"; DIV="${SPEC%:*}"; NORM="${SPEC#*:}"

POL="/scratch/$USER/bregman-lab/llm/results/bench/stageB_${DIV}_${NORM}_bdpo_token_bench1p7b_s${SEED}_policy"
TAG="${DIV}_${NORM}_bdpo_s${SEED}"
[ -d "$POL" ] || { echo "policy $POL missing — train it first"; exit 1; }

echo "=== gen Arena-Hard v0.1 [$TAG] from $POL on $(hostname) | $(date) ==="; nvidia-smi
python gen_bench.py --model "$POL" --generator "$TAG" --prompts data/arena_hard_v01.jsonl \
  --format arenav2 --think default --system "You are a helpful assistant." \
  --rep-penalty 1.05 --max-new 1024 --temperature 0.0 --out "results/bench/arena_v01/${TAG}.jsonl"
echo "=== done $TAG | $(date) ==="
