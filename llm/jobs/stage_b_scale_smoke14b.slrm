#!/bin/bash
# Scale-ablation SMOKE — Qwen3-14B-Base on 4× H100 FSDP. Validates 14B fits (policy 112G/4=28G + ref 28G
# replicated + acts ≈ 71G/80G — tightest config) and the FSDP save of a 14B checkpoint. Short + --save.
# Submit FROM llm/:  sbatch jobs/stage_b_scale_smoke14b.slrm
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=sm14b
#SBATCH --gres=gpu:h100:4
#SBATCH --cpus-per-task=24
#SBATCH --mem=800G
#SBATCH --time=2:00:00
#SBATCH --output=logs/%x-%j.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=6
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"
OUT_DIR="/scratch/$USER/bregman-lab/llm/results/bench"; mkdir -p "$OUT_DIR"

echo "=== 14B 4xH100 FSDP smoke (RKL canonical, 20 steps, +save) on $(hostname) | $(date) ==="; nvidia-smi
accelerate launch --config_file jobs/accel_fsdp.yaml --num_processes 4 --main_process_port 29540 \
  stage_b_train.py \
  --ref Qwen/Qwen3-14B-Base --policy Qwen/Qwen3-14B-Base --init-noise 0.01 \
  --data data/uf_pairs_train_full.jsonl --eval-data data/uf_pairs_test.jsonl \
  --div kl --norm canon --inner sample --step-mode token \
  --beta 0.1 --lr 5e-6 --lr-schedule linear --warmup-ratio 0.05 --weight-decay 0.01 --adam-beta2 0.999 \
  --steps 20 --grad-accum 64 --grad-clip 1.0 --max-len 1024 --clamp 15 \
  --eval-n 64 --log-every 5 --eval-every 10 --seed 0 --save-policy \
  --out "$OUT_DIR/smoke_scale14b_rkl_canon"
echo "=== smoke14b done | $(date) ==="
ls -la "$OUT_DIR/smoke_scale14b_rkl_canon_policy"/ 2>/dev/null | head
