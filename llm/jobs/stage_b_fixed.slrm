#!/bin/bash
# Stage B — FIXED-size step granularity dose-response at the MATCHED recipe. Single-sample f-DPO with
# --step-mode fixed --step-size N, for N in {8, 64}, over the 6 divergences. Confound-free coarsening
# knob (constant tokens/step, no variable-length effect): together with token (step_size 1 = stage_b_match)
# and newline (~sentence, stage_b_seg) it gives the granularity ladder 1 -> 8 -> newline(~20) -> 64,
# showing non-admissible Ω degrade monotonically as the step coarsens while RKL stays invariant.
# Needs results/sft_uc_1p7b_model + data/uf_pairs_train_full.jsonl. Submit FROM llm/:
#   sbatch jobs/stage_b_fixed.slrm
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=stageBfixed
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=1-12
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=18:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

DIVS=(kl adiv rkl js hel chi2)
STEPS=(8 64)
NS=${#STEPS[@]}
i=$((SLURM_ARRAY_TASK_ID - 1))
DIV="${DIVS[$((i / NS))]}"; STEP="${STEPS[$((i % NS))]}"
declare -A SHOW=([kl]=RKL [adiv]="α-div" [rkl]=FKL [js]=JS [hel]=Hel [chi2]="χ²")

echo "=== Stage B fixed-step Ω=${SHOW[$DIV]} (key $DIV) step_size=$STEP on $(hostname) | $(date) ==="; nvidia-smi

nvidia-smi --query-gpu=timestamp,utilization.gpu,memory.used --format=csv,noheader -l 30 \
  > "logs/gpu-${SLURM_JOB_ID}.csv" 2>/dev/null &
SMI_PID=$!

# SAME recipe as stage_b_match/seg; only --step-mode fixed --step-size differs.
python stage_b_train.py \
  --ref results/sft_uc_1p7b_model --policy results/sft_uc_1p7b_model --init-noise 0.01 \
  --data data/uf_pairs_train_full.jsonl --eval-data data/uf_pairs_test.jsonl \
  --div "$DIV" --inner sample --step-mode fixed --step-size "$STEP" \
  --beta 0.1 --lr 5e-5 --lr-schedule linear --warmup-ratio 0.05 --weight-decay 0.01 --adam-beta2 0.999 \
  --epochs 2 --grad-accum 512 --grad-clip 1.0 --max-len 1024 --clamp 15 \
  --eval-n 256 --log-every 5 --eval-every 25 --seed 0 --save-policy \
  --out "results/matched/stageB_${DIV}_s${STEP}_match1p7b"

kill "$SMI_PID" 2>/dev/null || true
echo "=== done fixed-step div=$DIV step_size=$STEP | $(date) ==="
