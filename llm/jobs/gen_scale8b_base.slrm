#!/bin/bash
# Arena-Hard v0.1 generation for the UNTRAINED 8B model (Qwen3-8B-Base) — the "before" reference the
# 8B policies are compared against, mirroring Base_repo.jsonl at 1.7B. Flags are byte-identical to
# gen_scale4b.slrm (same flags at every scale) / gen_arena_v01_repo.slrm so base and policies stay comparable.
#   sbatch jobs/gen_scale8b_base.slrm     (submit FROM llm/)
# Output: results/bench/arena_v01/scale8b_base.jsonl
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=gs8bbase
#SBATCH --gres=gpu:l40s:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=8:00:00
#SBATCH --output=logs/%x-%A.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

TAG="scale8b_base"
echo "=== gen Arena-Hard v0.1 [$TAG] from Qwen/Qwen3-8B-Base on $(hostname) | $(date) ==="; nvidia-smi
python gen_bench.py --model "Qwen/Qwen3-8B-Base" --generator "$TAG" --prompts data/arena_hard_v01.jsonl \
  --format arenav2 --think default --system "You are a helpful assistant." \
  --rep-penalty 1.05 --max-new 1024 --temperature 0.0 --out "results/bench/arena_v01/${TAG}.jsonl"
echo "=== done $TAG | $(date) ==="
