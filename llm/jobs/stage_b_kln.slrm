#!/bin/bash
# Stage B — kln (KL-normalized, f'(1)=1) single-sample sweep. Because kln gives f'(1)=1, the score
# has a nonzero init gradient at u=1, so this runs from the STANDARD π_ref init (π_θ = π_ref = base,
# NO SFT). 6 f-divergences (euc excluded from kln, Bregman). Prediction (Appendix E): kln removes the
# 1/u single-sample tail for χ² (bounded, RKL-like), softens Hel (√u), but α-div/JS/FKL keep the tail.
# Submit FROM llm/:  sbatch jobs/stage_b_kln.slrm
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=stageBkln
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=1-6
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=6:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

DIVS=(kl adiv rkl js hel chi2)          # euc excluded from kln (Bregman, no f(u) generator)
DIV="${DIVS[$((SLURM_ARRAY_TASK_ID - 1))]}"
declare -A SHOW=([kl]=RKL [adiv]="α-div" [rkl]=FKL [js]=JS [hel]=Hel [chi2]="χ²")   # kl=reverse-KL, rkl=forward-KL

echo "=== Stage B kln Ω=${SHOW[$DIV]} (key $DIV) on $(hostname) | $(date) ==="; nvidia-smi

# π_θ init = π_ref = base (no --policy): kln (f'(1)=1) avoids the u=1 freeze, so no SFT needed.
python stage_b_train.py \
  --ref Qwen/Qwen3-1.7B-Base \
  --div "$DIV" --inner sample --kln \
  --beta 0.1 --lr 1e-6 --grad-clip 10 --steps 2500 --grad-accum 8 --max-len 768 --clamp 15 \
  --eval-n 128 --seed 0 \
  --out "results/stageB_${DIV}_sample_kln1p7b"

echo "=== done kln div=$DIV | $(date) ==="
