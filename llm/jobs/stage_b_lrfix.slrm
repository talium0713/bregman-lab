#!/bin/bash
# Stage B — CLEAN batch axis at FIXED lr: isolate batch (=per-step variance) from lr. The earlier
# batch comparison confounded lr with batch (light b8 lr1e-6 · mid b64 lr5e-6 · matched b512 lr5e-5),
# so the b64↔b512 kln inconsistency could be an lr artifact. Here we hold lr=5e-6 AND UC-SFT init
# fixed (= the mid-sft b64 recipe) and run ONLY the two missing batches, b8 and b512. Combined with
# the existing results/mid/stageB_{div}_sft_{gran}[_kln]_mid1p7b (b64, lr5e-6, UC-SFT) this gives a
# clean 3-point batch axis {8,64,512}, all lr5e-6 + UC-SFT.
#
# Everything else = mid-sft: ref/policy = results/sft_uc_1p7b_model, --init-noise 0.01, UF-full, 2 ep,
# clamp 15, max-len 1024, grad-clip 1.0, linear lr + warmup .05, wd .01, β2 .999. Only --grad-accum
# (batch) and the per-batch eval/log cadence differ. Caveats to expect (report, don't hide):
#   · b8  @ lr5e-6 : 5× the light lr at batch 8 → noisier/less stable (grad-clip 1.0 guards). ~15.3k steps.
#   · b512@ lr5e-6 : 10× below matched's lr, only ~238 steps/2ep → may UNDERTRAIN (near init). That is
#                    itself the datapoint: does kln behave like b64 or like matched-b512 at THIS lr?
#
# 8 configs = {b8,b512}×{token,newline}×{no-kln,kln}, ×6 div = 48 tasks (config outer, div inner):
#   b8_token 1-6 · b8_token_kln 7-12 · b8_newline 13-18 · b8_newline_kln 19-24 ·
#   b512_token 25-30 · b512_token_kln 31-36 · b512_newline 37-42 · b512_newline_kln 43-48
# Submit FROM llm/:  sbatch jobs/stage_b_lrfix.slrm   |  batch-8 only: sbatch --array=1-24 …
# Output: results/lrfix/stageB_{div}_{label}_lrfix1p7b
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=stageBlrfix
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=1-48
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=20:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

CONFIGS=(
  "b8_token:8:--step-mode token --inner sample"
  "b8_token_kln:8:--step-mode token --inner sample --kln"
  "b8_newline:8:--step-mode newline --inner sample"
  "b8_newline_kln:8:--step-mode newline --inner sample --kln"
  "b512_token:512:--step-mode token --inner sample"
  "b512_token_kln:512:--step-mode token --inner sample --kln"
  "b512_newline:512:--step-mode newline --inner sample"
  "b512_newline_kln:512:--step-mode newline --inner sample --kln"
)
DIVS=(kl adiv rkl js hel chi2)
ND=${#DIVS[@]}
i=$((SLURM_ARRAY_TASK_ID - 1))
CFG="${CONFIGS[$((i / ND))]}"; DIV="${DIVS[$((i % ND))]}"
LABEL="${CFG%%:*}"; rest="${CFG#*:}"; BATCH="${rest%%:*}"; FLAGS="${rest#*:}"

# per-batch eval/log cadence so #evals stays ~50-80 (b8 ~15.3k steps, b512 ~238 steps)
if [ "$BATCH" -le 8 ]; then EVAL_EVERY=200; LOG_EVERY=50; else EVAL_EVERY=10; LOG_EVERY=2; fi

echo "=== Stage B lrfix Ω=$DIV cfg=$LABEL (batch=$BATCH lr=5e-6 $FLAGS) on $(hostname) | $(date) ==="; nvidia-smi
nvidia-smi --query-gpu=timestamp,utilization.gpu,memory.used --format=csv,noheader -l 30 \
  > "logs/gpu-${SLURM_JOB_ID}.csv" 2>/dev/null &
SMI_PID=$!

# = mid-sft recipe, lr FIXED 5e-6, only --grad-accum (batch) varies.
python stage_b_train.py \
  --ref results/sft_uc_1p7b_model --policy results/sft_uc_1p7b_model --init-noise 0.01 \
  --data data/uf_pairs_train_full.jsonl --eval-data data/uf_pairs_test.jsonl \
  --div "$DIV" $FLAGS \
  --beta 0.1 --lr 5e-6 --lr-schedule linear --warmup-ratio 0.05 --weight-decay 0.01 --adam-beta2 0.999 \
  --epochs 2 --grad-accum "$BATCH" --grad-clip 1.0 --max-len 1024 --clamp 15 \
  --eval-n 256 --log-every "$LOG_EVERY" --eval-every "$EVAL_EVERY" --seed 0 \
  --out "results/lrfix/stageB_${DIV}_${LABEL}_lrfix1p7b"

kill "$SMI_PID" 2>/dev/null || true
echo "=== done lrfix div=$DIV cfg=$LABEL | $(date) ==="
