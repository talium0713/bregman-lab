#!/bin/bash
# Arena-Hard v0.1 GENERATION with the STOP-TOKEN FIX (gen_bench now adds <|im_end|> as a stop id).
# ONLY change vs the original Qwen3-1.7B-Base.jsonl / sft_base.jsonl is the stop fix: same --think off
# (empty-<think>, training-consistent), same greedy 2048. Isolates whether the run-on-to-2048 bug
# (67% of base answers hit the cap → degenerate repetition) was what pinned us at 2.6 vs RePO's 10.4.
#   task 0 = Base_fix · task 1 = sft_base_fix.  (Answers should now be MUCH shorter → also faster.)
# Submit FROM llm/:  sbatch --exclude=kn010,kn001,kn035 jobs/gen_arena_v01_fix.slrm
# Output: results/bench/arena_v01/{tag}.jsonl  (then judge: JUDGE=gpt-4.1-2025-04-14 bash run_arena_v01_judge.sh)
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=genarenav01fix
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=0-1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=6:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

# tag:checkpoint
MODELS=(
  "Base_fix:Qwen/Qwen3-1.7B-Base"
  "sft_base_fix:results/sft_uc_1p7b_model"
)
E="${MODELS[$SLURM_ARRAY_TASK_ID]}"; TAG="${E%%:*}"; CKPT="${E#*:}"

echo "=== gen Arena-Hard v0.1 [$TAG] (stop-fix, --think off) from $CKPT on $(hostname) | $(date) ==="; nvidia-smi
python gen_bench.py --model "$CKPT" --generator "$TAG" --prompts data/arena_hard_v01.jsonl \
  --format arenav2 --think off --max-new 2048 --temperature 0.0 --out "results/bench/arena_v01/${TAG}.jsonl"
echo "=== done $TAG -> results/bench/arena_v01/${TAG}.jsonl | $(date) ==="
