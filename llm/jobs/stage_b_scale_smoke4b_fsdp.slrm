#!/bin/bash
# Scale-ablation SMOKE 2c — Qwen3-4B-Base on 2× L40S via Accelerate+FSDP. A SMALL, backfill-friendly job
# to validate the FSDP code path (shard + collective eval + full-state-dict SAVE) fast, decoupled from the
# heavier 8B/4×L40S fit test. 4B: policy /2 = ~24G + ref 8G = ~32G/48G/GPU.
# Submit FROM llm/:  sbatch jobs/stage_b_scale_smoke4b_fsdp.slrm
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=sbsm4bfsdp
#SBATCH --gres=gpu:l40s:2
#SBATCH --cpus-per-task=8
#SBATCH --mem=128G
#SBATCH --time=1:00:00
#SBATCH --output=logs/%x-%j.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=4
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

echo "=== 4B 2xL40S FSDP smoke (RKL canonical, 20 steps, +save) on $(hostname) | $(date) ==="; nvidia-smi
accelerate launch --config_file jobs/accel_fsdp.yaml --num_processes 2 --main_process_port 29502 \
  stage_b_train.py \
  --ref Qwen/Qwen3-4B-Base --policy Qwen/Qwen3-4B-Base --init-noise 0.01 \
  --data data/uf_pairs_train_full.jsonl --eval-data data/uf_pairs_test.jsonl \
  --div kl --norm canon --inner sample --step-mode token \
  --beta 0.1 --lr 5e-6 --lr-schedule linear --warmup-ratio 0.05 --weight-decay 0.01 --adam-beta2 0.999 \
  --steps 20 --grad-accum 64 --grad-clip 1.0 --max-len 1024 --clamp 15 \
  --eval-n 64 --log-every 5 --eval-every 10 --seed 0 --save-policy \
  --out results/bench/smoke_scale4b_fsdp_rkl_canon
echo "=== smoke2c done | $(date) ==="
ls -la results/bench/smoke_scale4b_fsdp_rkl_canon_policy/ 2>/dev/null | head
