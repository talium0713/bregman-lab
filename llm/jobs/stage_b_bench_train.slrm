#!/bin/bash
# Stage B — BENCHMARK train set: retrain the selected configs WITH --save-policy so they can be
# generated-from for AlpacaEval 2.0 / Arena-Hard v2 / MT-Bench. Current recipe (batch 64, lr 5e-6,
# UC-SFT init=ref +init-noise, single-sample, seed 0), granularity × divergence matrix.
#   12 tasks = {token,newline} × 6 div.  SFT baseline (results/sft_uc_1p7b_model) is already saved.
#   token = array 1-6 · newline = array 7-12 ; div inner (kl adiv rkl js hel chi2).
# Submit FROM llm/:  sbatch jobs/stage_b_bench_train.slrm
# Output: results/bench/stageB_{div}_{token|newline}_bench1p7b_policy   (+ .json curve)
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=stageBbenchtr
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=1-12
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=20:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

DIVS=(kl adiv rkl js hel chi2); ND=${#DIVS[@]}
i=$(( SLURM_ARRAY_TASK_ID - 1 ))
if [ "$i" -lt "$ND" ]; then GRAN=token; else GRAN=newline; fi
DIV="${DIVS[$(( i % ND ))]}"

echo "=== bench-train Ω=$DIV gran=$GRAN on $(hostname) | $(date) ==="; nvidia-smi

# current recipe + --save-policy; seed 0.
python stage_b_train.py \
  --ref results/sft_uc_1p7b_model --policy results/sft_uc_1p7b_model --init-noise 0.01 \
  --data data/uf_pairs_train_full.jsonl --eval-data data/uf_pairs_test.jsonl \
  --div "$DIV" --inner sample --step-mode "$GRAN" \
  --beta 0.1 --lr 5e-6 --lr-schedule linear --warmup-ratio 0.05 --weight-decay 0.01 --adam-beta2 0.999 \
  --epochs 2 --grad-accum 64 --grad-clip 1.0 --max-len 1024 --clamp 15 \
  --eval-n 256 --log-every 5 --eval-every 25 --seed 0 --save-policy \
  --out "results/bench/stageB_${DIV}_${GRAN}_bench1p7b"

echo "=== done bench-train Ω=$DIV gran=$GRAN | $(date) ==="
