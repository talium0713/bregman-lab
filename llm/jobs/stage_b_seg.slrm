#!/bin/bash
# Stage B — granularity experiment (token -> newline) at the MATCHED recipe. Runs newline-segmented
# single-sample f-DPO for the 6 divergences using the SAME standard-DPO recipe as stage_b_match
# (arXiv:2512.00778 Qwen3-1.7B). Paired with the token-level matched runs (stageB_{div}_match1p7b) this
# is a clean 2-point granularity comparison token -> newline per divergence, at ONE operating point
# (no recipe confound): RKL invariant, non-admissible noisier at the coarser (sentence) newline steps.
# Needs results/sft_uc_1p7b_model + data/uf_pairs_train_full.jsonl. Submit FROM llm/:
#   sbatch jobs/stage_b_seg.slrm
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=stageBseg
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=1-6
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=18:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

DIVS=(kl adiv rkl js hel chi2)          # kl=reverse-KL (their DPO), rkl=forward-KL
DIV="${DIVS[$((SLURM_ARRAY_TASK_ID - 1))]}"
declare -A SHOW=([kl]=RKL [adiv]="α-div" [rkl]=FKL [js]=JS [hel]=Hel [chi2]="χ²")

echo "=== Stage B seg (newline · matched recipe) Ω=${SHOW[$DIV]} (key $DIV) on $(hostname) | $(date) ==="; nvidia-smi

# background GPU-util logger -> logs/gpu-<jobid>.csv (tail -f for live util over time)
nvidia-smi --query-gpu=timestamp,utilization.gpu,memory.used --format=csv,noheader -l 30 \
  > "logs/gpu-${SLURM_JOB_ID}.csv" 2>/dev/null &
SMI_PID=$!

# SAME recipe as stage_b_match (arXiv:2512.00778 Qwen3-1.7B DPO); ONLY --step-mode newline differs.
# The token-level point of the granularity comparison = the stage_b_match runs (stageB_{div}_match1p7b).
python stage_b_train.py \
  --ref results/sft_uc_1p7b_model --policy results/sft_uc_1p7b_model --init-noise 0.01 \
  --data data/uf_pairs_train_full.jsonl --eval-data data/uf_pairs_test.jsonl \
  --div "$DIV" --inner sample --step-mode newline \
  --beta 0.1 --lr 5e-5 --lr-schedule linear --warmup-ratio 0.05 --weight-decay 0.01 --adam-beta2 0.999 \
  --epochs 2 --grad-accum 512 --grad-clip 1.0 --max-len 1024 --clamp 15 \
  --eval-n 256 --log-every 5 --eval-every 25 --seed 0 --save-policy \
  --out "results/matched/stageB_${DIV}_newline_match1p7b"

kill "$SMI_PID" 2>/dev/null || true
echo "=== done seg newline div=$DIV | $(date) ==="
