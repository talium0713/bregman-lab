#!/bin/bash
# Arena-Hard v0.1 GENERATION in RePO's chat mode: --think default = open assistant turn (NO empty
# <think> prefill), matching what the RePO author described (Qwen3 default chat template + vLLM).
# Isolates whether our enable_thinking=False (empty-think, direct-answer) was pinning the base model
# near the Arena floor (our 2.6 vs RePO table 10.4). Distinct _think tags so the no-think answers stay.
#   task 0 = Base_think · task 1 = sft_base_think.
# Submit FROM llm/:  sbatch --exclude=kn010,kn001,kn035 jobs/gen_arena_v01_think.slrm
# Output: results/bench/arena_v01/{tag}.jsonl  (then judge: JUDGE=gpt-4.1-2025-04-14 bash run_arena_v01_judge.sh)
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=genarenav01think
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=0-1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=6:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

# tag:checkpoint
MODELS=(
  "Base_think:Qwen/Qwen3-1.7B-Base"
  "sft_base_think:results/sft_uc_1p7b_model"
)
E="${MODELS[$SLURM_ARRAY_TASK_ID]}"; TAG="${E%%:*}"; CKPT="${E#*:}"

echo "=== gen Arena-Hard v0.1 [$TAG] (--think default) from $CKPT on $(hostname) | $(date) ==="; nvidia-smi
python gen_bench.py --model "$CKPT" --generator "$TAG" --prompts data/arena_hard_v01.jsonl \
  --format arenav2 --think default --max-new 2048 --temperature 0.0 --out "results/bench/arena_v01/${TAG}.jsonl"
echo "=== done $TAG -> results/bench/arena_v01/${TAG}.jsonl | $(date) ==="
