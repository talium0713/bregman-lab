#!/bin/bash
# Arena-Hard v0.1 GENERATION (RePO-match) for the 4B scale-ablation policies — ALL 6 divergences ×
# amari/canon (12), reading /scratch policies. Same regime as gen_normcmp_arena.slrm (comparable to fL3).
# L40S inference (4B ~8G/48G). Submit per divergence as policies finish, e.g. sbatch --array=2-11 (others).
#   array index = kl:amari kl:canon adiv:amari adiv:canon js:amari js:canon hel:amari hel:canon chi2:amari chi2:canon rkl:amari rkl:canon
# Output: results/bench/arena_v01/scale4b_{div}_{norm}_bdpo.jsonl
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=gs4b
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=0-11
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=6:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

SPECS=(kl:amari kl:canon adiv:amari adiv:canon js:amari js:canon hel:amari hel:canon chi2:amari chi2:canon rkl:amari rkl:canon)
SPEC="${SPECS[$SLURM_ARRAY_TASK_ID]}"; DIV="${SPEC%:*}"; NORM="${SPEC#*:}"
POL="/scratch/$USER/bregman-lab/llm/results/bench/stageB_scale4b_${DIV}_${NORM}_bdpo_token_policy"
TAG="scale4b_${DIV}_${NORM}_bdpo"
[ -d "$POL" ] || { echo "policy $POL missing — train it first"; exit 1; }

echo "=== gen Arena-Hard v0.1 [$TAG] from $POL on $(hostname) | $(date) ==="; nvidia-smi
python gen_bench.py --model "$POL" --generator "$TAG" --prompts data/arena_hard_v01.jsonl \
  --format arenav2 --think default --system "You are a helpful assistant." \
  --rep-penalty 1.05 --max-new 1024 --temperature 0.0 --out "results/bench/arena_v01/${TAG}.jsonl"
echo "=== done $TAG -> results/bench/arena_v01/${TAG}.jsonl | $(date) ==="
