#!/bin/bash
# Stage B — EXACT inner-term sweep. IDENTICAL conditions to stage_b_sample.slrm (same SFT init, same
# lr/clip/steps/clamp) with ONLY --inner exact. This is the CONTROL: with the exact (noise-free) inner
# term, all divergences should train to ~similar performance under the same tuning — so the
# single-sample degradation is isolated to the off-policy noise, NOT to the hyperparameters.
# 7 divergences (euc's exact inner term is well-defined). Output tag matches the sample sweep
# (stageB_{div}_exact_sft1p7b), so `fig_stage_b --tag sft1p7b` auto-renders the paired
# exact-vs-single-sample comparison once both are present. Run AFTER sft_base.slrm.
# Submit FROM llm/:  sbatch jobs/stage_b_exact.slrm
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=stageBex
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=1-7
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=8:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

DIVS=(kl adiv rkl js hel chi2 euc)
DIV="${DIVS[$((SLURM_ARRAY_TASK_ID - 1))]}"
declare -A SHOW=([kl]=RKL [adiv]="α-div" [rkl]=FKL [js]=JS [hel]=Hel [chi2]="χ²" [euc]=Euc)   # kl=reverse-KL, rkl=forward-KL

echo "=== Stage B exact Ω=${SHOW[$DIV]} (key $DIV) on $(hostname) | $(date) ==="; nvidia-smi

# SFT init + tuned hyperparams identical to stage_b_sample.slrm; ONLY --inner exact differs.
python stage_b_train.py \
  --ref Qwen/Qwen3-1.7B-Base --policy results/sft_1p7b_model \
  --div "$DIV" --inner exact \
  --beta 0.1 --lr 1e-6 --grad-clip 10 --steps 2500 --grad-accum 8 --max-len 768 --clamp 15 \
  --eval-n 128 --seed 0 \
  --out "results/stageB_${DIV}_exact_sft1p7b"

echo "=== done exact div=$DIV | $(date) ==="
