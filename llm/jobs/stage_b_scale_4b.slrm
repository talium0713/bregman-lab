#!/bin/bash
# Scale ablation — Qwen3-4B-Base full-FT DPO, amari vs canonical for all 6 divergences (12 policies).
# Single H100 per task (4B fits ~53G/80G, no FSDP), same recipe as the 1.7B fL3 runs (2 epochs, token,
# sample, lr5e-6/b64, init-noise 0.01). Array 0-11, throttled %4 to bound H100 usage.
# Submit FROM llm/:  sbatch jobs/stage_b_scale_4b.slrm
# Out: results/bench/stageB_scale4b_{div}_{norm}_bdpo_token_policy  ->  gen -> judge (A/B/C)
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=sw4b
#SBATCH --gres=gpu:h100:1
#SBATCH --array=0-11%4
#SBATCH --cpus-per-task=6
#SBATCH --mem=200G
#SBATCH --time=20:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"
OUT_DIR="/scratch/$USER/bregman-lab/llm/results/bench"; mkdir -p "$OUT_DIR"   # checkpoints -> /scratch (/project group quota is near full)

SPECS=(kl:amari kl:canon adiv:amari adiv:canon js:amari js:canon hel:amari hel:canon chi2:amari chi2:canon rkl:amari rkl:canon)
SPEC="${SPECS[$SLURM_ARRAY_TASK_ID]}"; DIV="${SPEC%:*}"; NORM="${SPEC#*:}"

echo "=== scale-4B [$DIV, norm=$NORM] full-FT (2ep) on $(hostname) | $(date) ==="; nvidia-smi
python stage_b_train.py \
  --ref Qwen/Qwen3-4B-Base --policy Qwen/Qwen3-4B-Base --init-noise 0.01 \
  --data data/uf_pairs_train_full.jsonl --eval-data data/uf_pairs_test.jsonl \
  --div "$DIV" --norm "$NORM" --inner sample --step-mode token \
  --beta 0.1 --lr 5e-6 --lr-schedule linear --warmup-ratio 0.05 --weight-decay 0.01 --adam-beta2 0.999 \
  --epochs 2 --grad-accum 64 --grad-clip 1.0 --max-len 1024 --clamp 15 \
  --eval-n 256 --log-every 25 --eval-every 100 --seed 0 --save-policy \
  --out "$OUT_DIR/stageB_scale4b_${DIV}_${NORM}_bdpo_token"
echo "=== done scale-4B [$DIV, norm=$NORM] | $(date) ==="
