#!/bin/bash
# Arena-Hard v2.0 GENERATION (offline GPU): greedy 2048-token answers on the 750 Arena-Hard v2 prompts
# for the SFT baseline (task 0) + the bench policies. Emits the Arena-Hard v2 answer schema (--format
# arenav2). Stage 2 (JUDGING with gpt-4.1) runs on a LOGIN node via run_arena_judge.sh (needs internet).
#
# Needs: data/arena_hard_v2.jsonl (make_bench_prompts.py --which arena, on a login node first),
#        results/sft_uc_1p7b_model, results/bench/stageB_{div}_{token|newline}_bench1p7b_policy.
#   task 0 = SFT · 1-6 = newline divs · 7-12 = token divs  (kl adiv rkl js hel chi2).
# Submit FROM llm/ AFTER stage_b_bench_train finishes.  Lean set (SFT + newline 6): sbatch --array=0-6 …
#   sbatch jobs/gen_bench_arena.slrm
# Output: results/bench/arena/{tag}.jsonl
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=genarena
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=0-12
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=12:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

DIVS=(kl adiv rkl js hel chi2); ND=${#DIVS[@]}
declare -A SHOW=([kl]=RKL [adiv]=alphadiv [rkl]=FKL [js]=JS [hel]=Hel [chi2]=chi2)
i=$SLURM_ARRAY_TASK_ID
if [ "$i" -eq 0 ]; then
  MODEL="results/sft_uc_1p7b_model"; TAG="sft_base"
elif [ "$i" -le "$ND" ]; then
  DIV="${DIVS[$((i - 1))]}"; MODEL="results/bench/stageB_${DIV}_newline_bench1p7b_policy"; TAG="${SHOW[$DIV]}-newline"
else
  DIV="${DIVS[$((i - 1 - ND))]}"; MODEL="results/bench/stageB_${DIV}_token_bench1p7b_policy"; TAG="${SHOW[$DIV]}-token"
fi

echo "=== gen Arena-Hard v2 [$TAG] from $MODEL on $(hostname) | $(date) ==="; nvidia-smi
python gen_bench.py --model "$MODEL" --prompts data/arena_hard_v2.jsonl \
  --generator "$TAG" --format arenav2 --max-new 2048 --temperature 0.0 \
  --out "results/bench/arena/${TAG}.jsonl"
echo "=== done $TAG -> results/bench/arena/${TAG}.jsonl | $(date) ==="
