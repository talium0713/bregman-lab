#!/bin/bash
# 4B LoRA, RKL only, Amari vs canonical, seeds 0/1/2 — six runs on a single L40S each.
#
# WHY LoRA AT 4B. At 8B, switching from full fine-tuning to a rank-128 adapter moved the canonical
# win rate from 74.2% [71.0,77.5] to 57.9% [54.2,61.5] — non-overlapping intervals, from changing
# nothing but which parameters are updated. There, the cause is identified: full-FT Amari truncates
# 80.0% of its answers at the token cap while the LoRA one truncates 7.8%, the same as the untrained
# base. 4B is the control that says whether that explanation is complete, because 4B full-FT has NO
# termination pathology (Amari 14.8% at cap, canonical 24.6% — canonical is the longer arm there).
# So if 4B also splits between full-FT and LoRA, the 16-point gap at 8B is not only about truncation
# and the story has to change.
#
# WHY L40S. This sidesteps the h100 queue entirely, where 29 4B jobs have been stuck for four days.
# 8B LoRA peaked at 28.2 GB on an L40S; 4B is roughly 17 GB, so there is plenty of room.
#
# Config matches jobs/stage_b_lora_8b_l40s.slrm exactly apart from the model: r=alpha=128, dropout
# 0.05, all seven linear projections, gradient checkpointing ON (the 8B setting), lr 5e-6, 2 epochs.
# Everything else is byte-identical to the 4B full-FT recipe so the two are comparable.
#
# WALLTIME. 8B LoRA measured 77.6 s/step on L40S; 4B should be roughly half, so ~22 h for 1910 steps.
# 36 h covers up to ~68 s/step. --save-adapter-every 200 writes a recoverable adapter every ~1.2 h,
# so an overrun costs one interval rather than the run (merge it back with merge_adapter.py).
#
#   array index = seed*2 + {0:amari, 1:canon}, i.e. 0-1 seed 0, 2-3 seed 1, 4-5 seed 2
# Out: $OUT_DIR/stageB_lora4b_kl_{amari,canon}_bdpo_token_s{0,1,2}
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=lora4b
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=0-5%3
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=36:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"
OUT_DIR="/scratch/$USER/bregman-lab/llm/results/bench"; mkdir -p "$OUT_DIR"   # never /project (quota)

NORMS=(amari canon)
SEED=$((SLURM_ARRAY_TASK_ID / 2)); NORM="${NORMS[$((SLURM_ARRAY_TASK_ID % 2))]}"; DIV=kl

echo "=== 4B LoRA [$DIV, norm=$NORM, seed=$SEED] 1xL40S (2ep) on $(hostname) | $(date) ==="; nvidia-smi
python stage_b_train.py \
  --ref Qwen/Qwen3-4B-Base --policy Qwen/Qwen3-4B-Base --init-noise 0.01 \
  --lora-r 128 --lora-alpha 128 --lora-dropout 0.05 --save-adapter-every 200 \
  --data data/uf_pairs_train_full.jsonl --eval-data data/uf_pairs_test.jsonl \
  --div "$DIV" --norm "$NORM" --inner sample --step-mode token \
  --beta 0.1 --lr 5e-6 --lr-schedule linear --warmup-ratio 0.05 --weight-decay 0.01 --adam-beta2 0.999 \
  --epochs 2 --grad-accum 64 --grad-clip 1.0 --max-len 1024 --clamp 15 \
  --eval-n 256 --log-every 25 --eval-every 100 --seed "$SEED" --save-policy \
  --out "$OUT_DIR/stageB_lora4b_${DIV}_${NORM}_bdpo_token_s${SEED}"
echo "=== done 4B LoRA [$DIV, norm=$NORM, seed=$SEED] | $(date) ==="
