#!/bin/bash
# Arena-Hard v0.1 GENERATION matching RePO's model_generation.py as faithfully as HF .generate allows:
#   --think default        : open assistant turn (no empty <think> prefill)
#   --system "You are a helpful assistant."
#   --rep-penalty 1.05     : kills degenerate repetition loops (umably…, "A B C D E F G")
#   stop_strings + stop_ids: <|im_end|>(151645), <|endoftext|>(151643), "\n\nQuestion:", … (built into gen_bench)
#   --max-new 1024, greedy (temperature 0)
# This is the real fix for the base run-on: rep_penalty + string stops, NOT just the <|im_end|> token stop
# (raw base never emits <|im_end|>, so the token stop alone did nothing — Base_fix == Base).
#   task 0 = Base_repo · task 1 = sft_base_repo.
# Submit FROM llm/:  sbatch --exclude=kn010,kn001,kn035 jobs/gen_arena_v01_repo.slrm
# Output: results/bench/arena_v01/{tag}.jsonl  (then judge: JUDGE=gpt-4.1-2025-04-14 bash run_arena_v01_judge.sh)
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=genarenav01repo
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=0-1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=6:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

# tag:checkpoint
MODELS=(
  "Base_repo:Qwen/Qwen3-1.7B-Base"
  "sft_base_repo:results/sft_uc_1p7b_model"
)
E="${MODELS[$SLURM_ARRAY_TASK_ID]}"; TAG="${E%%:*}"; CKPT="${E#*:}"

echo "=== gen Arena-Hard v0.1 [$TAG] (RePO-match) from $CKPT on $(hostname) | $(date) ==="; nvidia-smi
python gen_bench.py --model "$CKPT" --generator "$TAG" --prompts data/arena_hard_v01.jsonl \
  --format arenav2 --think default --system "You are a helpful assistant." \
  --rep-penalty 1.05 --max-new 1024 --temperature 0.0 --out "results/bench/arena_v01/${TAG}.jsonl"
echo "=== done $TAG -> results/bench/arena_v01/${TAG}.jsonl | $(date) ==="
