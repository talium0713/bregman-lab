#!/bin/bash
# Arena-Hard v0.1 GENERATION (RePO-match) for the scale-ablation RKL policies (4B/8B/14B × amari/canon),
# reading the trained policies from /scratch. Same regime as gen_normcmp_arena.slrm so win-rates are
# directly comparable to the 1.7B fL3 numbers. Inference fits 1× L40S even for 14B (~28G/48G) — L40S is
# plentiful, avoids H100 contention.
#   array 0-5 = scale4b:amari scale4b:canon scale8b:amari scale8b:canon scale14b:amari scale14b:canon
# Submit per size as policies finish, e.g.:  sbatch --array=0,1 jobs/gen_scale.slrm   (4B)
# Output: results/bench/arena_v01/{size}_kl_{norm}_bdpo.jsonl   (small; then judge with gpt-4.1-mini)
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=genscale
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=0-5
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=6:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

SPECS=(scale4b:amari scale4b:canon scale8b:amari scale8b:canon scale14b:amari scale14b:canon)
SPEC="${SPECS[$SLURM_ARRAY_TASK_ID]}"; SIZE="${SPEC%:*}"; NORM="${SPEC#*:}"
SCRATCH="/scratch/$USER/bregman-lab/llm/results/bench"
POL="$SCRATCH/stageB_${SIZE}_kl_${NORM}_bdpo_token_policy"
TAG="${SIZE}_kl_${NORM}_bdpo"
[ -d "$POL" ] || { echo "policy $POL missing — train it first"; exit 1; }

echo "=== gen Arena-Hard v0.1 [$TAG] (RePO-match) from $POL on $(hostname) | $(date) ==="; nvidia-smi
python gen_bench.py --model "$POL" --generator "$TAG" --prompts data/arena_hard_v01.jsonl \
  --format arenav2 --think default --system "You are a helpful assistant." \
  --rep-penalty 1.05 --max-new 1024 --temperature 0.0 --out "results/bench/arena_v01/${TAG}.jsonl"
echo "=== done $TAG -> results/bench/arena_v01/${TAG}.jsonl | $(date) ==="
