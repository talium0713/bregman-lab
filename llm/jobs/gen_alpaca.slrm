#!/bin/bash
# AlpacaEval stage 1 (GENERATION, offline GPU): greedy 512-token responses on the 805 AlpacaEval prompts
# for the SFT baseline (task 0) + the 6 matched divergence policies (tasks 1-6). Stage 2 (JUDGING) runs
# `alpaca_eval` with a GPT-4 judge on a machine with internet + OPENAI_API_KEY (see footer).
# Needs: data/alpaca_eval.jsonl, results/sft_uc_1p7b_model, results/stageB_{div}_match1p7b_policy.
# Submit FROM llm/ AFTER stage_b_match finishes:  sbatch jobs/gen_alpaca.slrm
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=genalpaca
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=0-6
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=4:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

DIVS=(kl adiv rkl js hel chi2)
declare -A SHOW=([kl]=RKL [adiv]=alphadiv [rkl]=FKL [js]=JS [hel]=Hel [chi2]=chi2)
i=$SLURM_ARRAY_TASK_ID
if [ "$i" -eq 0 ]; then                          # task 0 = SFT baseline (the reference for win rate)
  MODEL="results/sft_uc_1p7b_model"; GEN="sft_base"; OUT="results/alpaca_sft_base.json"
else
  DIV="${DIVS[$((i - 1))]}"; MODEL="results/stageB_${DIV}_match1p7b_policy"; GEN="${SHOW[$DIV]}"; OUT="results/alpaca_${DIV}.json"
fi

echo "=== gen AlpacaEval [$GEN] from $MODEL on $(hostname) | $(date) ==="; nvidia-smi
python gen_alpaca.py --model "$MODEL" --prompts data/alpaca_eval.jsonl --generator "$GEN" --max-new 512 --out "$OUT"
echo "=== done $GEN -> $OUT | $(date) ==="

# ─── Stage 2 (run on your Mac, NOT the cluster — needs internet + a judge API) ───────────────
#   pip install alpaca-eval
#   export OPENAI_API_KEY=sk-...
#   for d in kl adiv rkl js hel chi2; do
#     alpaca_eval --model_outputs results/alpaca_${d}.json \
#                 --reference_outputs results/alpaca_sft_base.json \
#                 --annotators_config weighted_alpaca_eval_gpt4_turbo --output_path results/ae_${d}
#   done
# win rate (candidate vs SFT baseline) is in each results/ae_${d}/ leaderboard.
