#!/bin/bash
# FKL under the Amari STANDARD form (f'(1)=0) — the missing "amari" cell for FKL. The base->f-DPO sweep
# trained FKL only in its NATURAL form (f'(1)=-1, key rkl); this adds the f'(1)=0 form so FKL has the
# same amari-vs-canonical pair as the others. Same recipe as stage_b_normcmp_arena.slrm.
# Submit FROM llm/:  sbatch --exclude=kn010,kn001,kn035 jobs/stage_b_fkl_amari.slrm
# Output: results/bench/stageB_rkl_amari_bdpo_token_bench1p7b_policy (+ .json curve)
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=fklamari
#SBATCH --gres=gpu:l40s:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=20:00:00
#SBATCH --output=logs/%x-%j.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

echo "=== FKL amari (div rkl, norm amari, f'(1)=0) on $(hostname) | $(date) ==="; nvidia-smi
python stage_b_train.py \
  --ref Qwen/Qwen3-1.7B-Base --policy Qwen/Qwen3-1.7B-Base --init-noise 0.01 \
  --data data/uf_pairs_train_full.jsonl --eval-data data/uf_pairs_test.jsonl \
  --div rkl --norm amari --inner sample --step-mode token \
  --beta 0.1 --lr 5e-6 --lr-schedule linear --warmup-ratio 0.05 --weight-decay 0.01 --adam-beta2 0.999 \
  --epochs 2 --grad-accum 64 --grad-clip 1.0 --max-len 1024 --clamp 15 \
  --eval-n 256 --log-every 5 --eval-every 25 --seed 0 --save-policy \
  --out "results/bench/stageB_rkl_amari_bdpo_token_bench1p7b"
echo "=== done FKL amari | $(date) ==="
