#!/bin/bash
# Stage B — TOKEN + kln at the MATCHED recipe (the missing cell of the token/newline × kln/no-kln 2×2).
# Identical to stage_b_match (token, matched recipe) EXCEPT --kln. Controls the recipe so the kln effect
# can be read at token vs newline WITHOUT the light-recipe confound of the old kln1p7b runs.
# Prediction: ≈ neutral vs token no-kln (batch 512 already averages the single-sample noise, and u_t≈1
# so the kln shift s(1−1/u_t)≈0) — i.e. kln's benefit needs noise to remove and its objective change is
# tiny at token; the harm only shows at newline where u_k=∏u_t is far from 1.
# Needs results/sft_uc_1p7b_model + data/uf_pairs_train_full.jsonl. Submit FROM llm/:
#   sbatch jobs/stage_b_token_kln.slrm
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=stageBtokkln
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=1-6
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=18:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

DIVS=(kl adiv rkl js hel chi2)
DIV="${DIVS[$((SLURM_ARRAY_TASK_ID - 1))]}"
declare -A SHOW=([kl]=RKL [adiv]="α-div" [rkl]=FKL [js]=JS [hel]=Hel [chi2]="χ²")

echo "=== Stage B TOKEN+kln Ω=${SHOW[$DIV]} (key $DIV) on $(hostname) | $(date) ==="; nvidia-smi

nvidia-smi --query-gpu=timestamp,utilization.gpu,memory.used --format=csv,noheader -l 30 \
  > "logs/gpu-${SLURM_JOB_ID}.csv" 2>/dev/null &
SMI_PID=$!

# SAME as stage_b_match (token, matched recipe) + --kln. Only the generator normalization differs.
python stage_b_train.py \
  --ref results/sft_uc_1p7b_model --policy results/sft_uc_1p7b_model --init-noise 0.01 --kln \
  --data data/uf_pairs_train_full.jsonl --eval-data data/uf_pairs_test.jsonl \
  --div "$DIV" --inner sample --step-mode token \
  --beta 0.1 --lr 5e-5 --lr-schedule linear --warmup-ratio 0.05 --weight-decay 0.01 --adam-beta2 0.999 \
  --epochs 2 --grad-accum 512 --grad-clip 1.0 --max-len 1024 --clamp 15 \
  --eval-n 256 --log-every 5 --eval-every 25 --seed 0 --save-policy \
  --out "results/matched/stageB_${DIV}_kln_match1p7b"

kill "$SMI_PID" 2>/dev/null || true
echo "=== done TOKEN+kln div=$DIV | $(date) ==="
