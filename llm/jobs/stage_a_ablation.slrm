#!/bin/bash
# Model-size ablation of Stage A: run the off-policy inner-term measurement for Qwen3 0.6B / 1.7B / 4B
# (π_ref = base, π_θ = instruct each). Forward-only, so 1× L40S each — even 4B (exact_C is chunked).
# One array task per size. Submit FROM llm/:  sbatch jobs/stage_a_ablation.slrm
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=stageA_abl
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=1-3
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=1:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

SIZES=(0.6B 1.7B 4B)
TAGS=(0p6b 1p7b 4b)
i=$((SLURM_ARRAY_TASK_ID - 1))
S="${SIZES[$i]}"; TAG="${TAGS[$i]}"

echo "=== stageA ablation size=$S on $(hostname) | $(date) ==="; nvidia-smi

python stage_a_measure.py \
  --ref "Qwen/Qwen3-${S}-Base" --policy "Qwen/Qwen3-${S}" \
  --data data/uf_test_prefs.jsonl --max-samples 500 --max-len 1024 --exact \
  --out "results/stageA_qwen3_${TAG}"

echo "=== done size=$S | $(date) ==="
