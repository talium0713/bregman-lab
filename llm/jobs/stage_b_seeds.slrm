#!/bin/bash
# Stage B — SEED REPLICATION of the current settled recipe (Recipe-for-Experiments page): batch 64,
# lr 5e-6, UC-SFT init=ref (+init-noise .01), single-sample, for error bars / reproducibility. Runs the
# 2 ADDITIONAL seeds {1,2} (seed 0 = the existing results/mid runs) over the 6 divergences ×
# {token,newline} × {no-kln,kln}. Seed is recorded in the output filename AND in each json's args.seed.
#   SEEDS USED (recorded): 0 (results/mid, already done) · 1 · 2   → 3 seeds total.
#
# 48 tasks = 2 seeds × 24 configs (6 div × {token,newline} × {no-kln,kln}). Layout: seed outer.
#   seed1 = array 1-24 · seed2 = array 25-48 ; within a seed, div inner (6), then gran×kln (4).
# Submit FROM llm/:  sbatch jobs/stage_b_seeds.slrm   |  seed1 single-sample only: sbatch --array=1-12 …
# Output: results/seeds/stageB_{div}_{label}_seed{S}_1p7b   (label = {token,newline}[_kln])
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=stageBseeds
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=1-48
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=20:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

SEEDS=(1 2)                                     # the 2 additional seeds (seed 0 = results/mid)
DIVS=(kl adiv rkl js hel chi2)
GK=(                                            # gran×kln config: label:flags
  "token:--step-mode token --inner sample"
  "token_kln:--step-mode token --inner sample --kln"
  "newline:--step-mode newline --inner sample"
  "newline_kln:--step-mode newline --inner sample --kln"
)
ND=${#DIVS[@]}; NCFG=$(( ND * ${#GK[@]} ))      # 24 configs per seed
i=$(( SLURM_ARRAY_TASK_ID - 1 ))
SEED="${SEEDS[$(( i / NCFG ))]}"
j=$(( i % NCFG ))
DIV="${DIVS[$(( j % ND ))]}"
CFG="${GK[$(( j / ND ))]}"; LABEL="${CFG%%:*}"; FLAGS="${CFG#*:}"

echo "=== Stage B SEED=$SEED Ω=$DIV cfg=$LABEL ($FLAGS) on $(hostname) | $(date) ==="; nvidia-smi

# current settled recipe (= mid-sft): batch 64, lr 5e-6, UC-SFT init=ref +init-noise; only --seed varies.
python stage_b_train.py \
  --ref results/sft_uc_1p7b_model --policy results/sft_uc_1p7b_model --init-noise 0.01 \
  --data data/uf_pairs_train_full.jsonl --eval-data data/uf_pairs_test.jsonl \
  --div "$DIV" $FLAGS \
  --beta 0.1 --lr 5e-6 --lr-schedule linear --warmup-ratio 0.05 --weight-decay 0.01 --adam-beta2 0.999 \
  --epochs 2 --grad-accum 64 --grad-clip 1.0 --max-len 1024 --clamp 15 \
  --eval-n 256 --log-every 5 --eval-every 25 --seed "$SEED" \
  --out "results/seeds/stageB_${DIV}_${LABEL}_seed${SEED}_1p7b"

echo "=== done SEED=$SEED div=$DIV cfg=$LABEL | $(date) ==="
