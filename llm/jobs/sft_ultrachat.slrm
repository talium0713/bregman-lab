#!/bin/bash
# Zephyr-style SFT of Qwen3-1.7B-Base on UltraChat-200k -> the chat SFT init used by arXiv:2512.00778
# before DPO (replaces the light chosen-SFT). 1 epoch, lr 2e-5 cosine + 10% warmup (Zephyr recipe).
# This is the SLOW step (~full pass over UltraChat). Submit FROM llm/:  sbatch jobs/sft_ultrachat.slrm
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=sftuc
#SBATCH --gres=gpu:l40s:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=20:00:00
#SBATCH --output=logs/%x-%j.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

echo "=== UltraChat SFT on $(hostname) | $(date) ==="; nvidia-smi

# Zephyr SFT recipe: 1 epoch, lr 2e-5, cosine schedule, 10% warmup, effective batch 64, max_len 2048.
python sft_base.py --model Qwen/Qwen3-1.7B-Base \
  --data data/ultrachat_sft.jsonl --field messages \
  --epochs 1 --lr 2e-5 --lr-schedule cosine --warmup-ratio 0.1 --weight-decay 0.0 \
  --grad-accum 64 --max-len 2048 --grad-clip 1.0 --out results/sft_uc_1p7b

# sanity: the SFT moved pi_theta off the base (u should spread; min_u << 1)
python stage_a_measure.py --ref Qwen/Qwen3-1.7B-Base --policy results/sft_uc_1p7b_model \
  --data data/uf_pairs_test.jsonl --max-samples 200 --max-len 768 --out results/sft_uc_offpolicy_check

echo "=== done | $(date) ==="
