#!/bin/bash
# Arena-Hard v0.1 GENERATION for the Base->DPO policy (results/bench/stageB_kl_basedpo_token_bench1p7b_policy).
# Meant to be submitted with a dependency on the Base->DPO training job so it auto-runs when training finishes:
#   sbatch --dependency=afterok:<basedpo_jobid> --exclude=kn010,kn001 jobs/gen_basedpo_v01.slrm
# greedy 2048-tok, arenav2 schema, 500 v0.1 prompts. Output: results/bench/arena_v01/basedpo_token.jsonl
# Then judge (login node, API): JUDGE=gpt-4.1-2025-04-14 bash run_arena_v01_judge.sh
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=genbasedpov01
#SBATCH --gres=gpu:l40s:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=6:00:00
#SBATCH --output=logs/%x-%A.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

POL="results/bench/stageB_kl_basedpo_token_bench1p7b_policy"
[ -d "$POL" ] || { echo "policy $POL missing — Base->DPO training failed?"; exit 1; }

echo "=== gen Arena-Hard v0.1 [basedpo_repo] (RePO-match) from $POL on $(hostname) | $(date) ==="; nvidia-smi
# RePO-match generation so the DPO number is apples-to-apples with Base_repo (11.2): open turn + system
# prompt + repetition_penalty 1.05 + string/token stops + max 1024. (basedpo_token, the old no-rep_penalty
# run, is discarded.)
python gen_bench.py --model "$POL" --generator "basedpo_repo" --prompts data/arena_hard_v01.jsonl \
  --format arenav2 --think default --system "You are a helpful assistant." \
  --rep-penalty 1.05 --max-new 1024 --temperature 0.0 --out "results/bench/arena_v01/basedpo_repo.jsonl"
echo "=== done basedpo_repo -> results/bench/arena_v01/basedpo_repo.jsonl | $(date) ==="
