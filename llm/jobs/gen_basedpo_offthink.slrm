#!/bin/bash
# Arena-Hard v0.1 GENERATION of the Base->DPO policy in the TRAIN-CONSISTENT regime, to test whether the
# RePO-match eval (basedpo_repo=15.3, generated with --think default + system) UNDERstated the DPO because
# the policy was TRAINED with --think off (empty <think> prefill) and NO system prompt.
#   Only the template differs vs basedpo_repo: --think off, NO --system. Everything else identical
#   (repetition_penalty 1.05, string/token stops, greedy, max 1024) so the comparison isolates the template.
#   basedpo_repo   : --think default --system "You are a helpful assistant."   -> 15.3
#   basedpo_offthink (this): --think off  (matches how the DPO was trained)    -> ?
# Submit FROM llm/:  sbatch --exclude=kn010,kn001,kn035 jobs/gen_basedpo_offthink.slrm
# Output: results/bench/arena_v01/basedpo_offthink.jsonl  (then judge: JUDGE=gpt-4.1-2025-04-14 bash run_arena_v01_judge.sh)
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=genbasedpooff
#SBATCH --gres=gpu:l40s:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=6:00:00
#SBATCH --output=logs/%x-%A.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

POL="results/bench/stageB_kl_basedpo_token_bench1p7b_policy"
[ -d "$POL" ] || { echo "policy $POL missing"; exit 1; }

echo "=== gen Arena-Hard v0.1 [basedpo_offthink] (train-consistent: --think off, no system) from $POL on $(hostname) | $(date) ==="; nvidia-smi
python gen_bench.py --model "$POL" --generator "basedpo_offthink" --prompts data/arena_hard_v01.jsonl \
  --format arenav2 --think off \
  --rep-penalty 1.05 --max-new 1024 --temperature 0.0 --out "results/bench/arena_v01/basedpo_offthink.jsonl"
echo "=== done basedpo_offthink -> results/bench/arena_v01/basedpo_offthink.jsonl | $(date) ==="
