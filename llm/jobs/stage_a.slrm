#!/bin/bash
# Stage A — measure off-policy inner-term noise (NO training). Forward-only, so 1× L40S is enough
# even for 4B. Submit FROM llm/:  sbatch jobs/stage_a.slrm
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=stageA
#SBATCH --gres=gpu:l40s:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=1:00:00
#SBATCH --output=logs/%x-%j.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="$HOME/projects/aip-rudner/$USER/hf_cache"
export HF_HUB_OFFLINE=1                 # compute node has no internet; use the prefetched cache
export TOKENIZERS_PARALLELISM=false

module load python/3.12 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

echo "=== stage A on $(hostname) | $(date) ==="; nvidia-smi

python stage_a_measure.py \
  --ref Qwen/Qwen3-1.7B-Base --policy Qwen/Qwen3-1.7B \
  --dataset HuggingFaceH4/ultrafeedback_binarized --split test_prefs \
  --max-samples 500 --max-len 1024 --exact \
  --out results/stageA_qwen3_1p7b

echo "=== done | $(date) ==="
