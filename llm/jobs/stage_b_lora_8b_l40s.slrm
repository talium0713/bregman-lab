#!/bin/bash
# Qwen3-8B-Base DPO with LoRA on a SINGLE L40S — RKL, canonical vs Amari (array 0=amari, 1=canon).
# This is the SHAREABLE version: it needs one ordinary 48G GPU and no multi-GPU setup at all.
#
# WHY THIS EXISTS. 8B full-FT DPO needs 4x H100, and not because of the policy: under FSDP each rank
# holds 16G params + 16G optimiser + a REPLICATED 16G frozen reference, and only the first two shard.
# Under LoRA the reference disappears — disabling the adapter restores the base weights, which ARE
# pi_ref (the trick TRL uses in DPOTrainer). Measured on this exact config: 28.1G peak. One L40S.
# Budget: 17.1G base (bf16) + 5.6G adapter/grads/optimiser (peft builds LoRA weights in fp32) + logits.
#
# WHY L40S RATHER THAN H100. Measured 90 s/step on L40S vs 50 s/step on H100 — only 1.8x slower,
# far better than the ~4x the memory-bandwidth ratio suggests (this workload runs under 10% MFU).
# And Killarney's walltime tiers are far kinder to L40S:
#       <=24h : h100 6 nodes (48 GPU)  |  l40s 84 nodes (336 GPU)
#       <=3d  : h100 4 nodes (32 GPU)  |  l40s 42 nodes (168 GPU)
# So a 3-day L40S request still reaches 3.5x more capacity than a 1-day H100 request. That buys the
# thing that actually matters scientifically: a FULL 2-EPOCH run, identical to the full-FT 8B recipe,
# so absolute win rates stay comparable to the full-FT 8B table. On H100 we could only afford 1 epoch.
#
# BUDGET. 61,135 pairs / grad-accum 64 = 955 steps per epoch, so 2 epochs = 1,910 steps.
# 1,910 x 90s = 47.8h; with eval/load/merge ~49h. --time is 68h: that covers up to ~128 s/step and
# still sits in the 3-day tier.
# --save-adapter-every 100 writes a 1.4G adapter every ~2.4h, so a node failure costs one interval
# instead of the whole run; rescue it with  python merge_adapter.py --adapter ..._adapter --out ..._policy
#
# HYPERPARAMETERS follow the alignment-handbook Zephyr-7b-beta DPO QLoRA recipe
# (recipes/zephyr-7b-beta/dpo/config_qlora.yaml): r=alpha=128, dropout 0.05, adapters on all seven
# linear projections, max_length 1024, lr 5e-6. Everything else is byte-identical to the full-FT 8B
# job (jobs/stage_b_scale_8b.slrm) so the two are comparable.
#
# Submit FROM llm/:  sbatch jobs/stage_b_lora_8b_l40s.slrm
# Out: $OUT_DIR/stageB_lora8b_kl_{amari,canon}_bdpo_token_policy   (+ .json curve, + _adapter)
# See jobs/LORA_HANDOFF.md for the full setup.
#
#SBATCH --account=aip-rudner
#SBATCH --job-name=lora8bL
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=0-1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=68:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="${HF_HOME:-/scratch/$USER/hf_cache}"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"
# NEVER /project: it runs at ~99% of a 5 TiB group quota and one saved 8B policy is 16 GB.
OUT_DIR="${OUT_DIR:-/scratch/$USER/bregman-lab/llm/results/bench}"; mkdir -p "$OUT_DIR"

NORMS=(amari canon)
NORM="${NORMS[$SLURM_ARRAY_TASK_ID]}"
DIV=kl                                   # code key kl == reverse KL (SHORT maps kl->RKL, rkl->FKL)

echo "=== 8B LoRA [$DIV, norm=$NORM] 1xL40S (2ep) on $(hostname) | $(date) ==="; nvidia-smi
python stage_b_train.py \
  --ref Qwen/Qwen3-8B-Base --policy Qwen/Qwen3-8B-Base --init-noise 0.01 \
  --lora-r 128 --lora-alpha 128 --lora-dropout 0.05 --save-adapter-every 100 \
  --data data/uf_pairs_train_full.jsonl --eval-data data/uf_pairs_test.jsonl \
  --div "$DIV" --norm "$NORM" --inner sample --step-mode token \
  --beta 0.1 --lr 5e-6 --lr-schedule linear --warmup-ratio 0.05 --weight-decay 0.01 --adam-beta2 0.999 \
  --epochs 2 --grad-accum 64 --grad-clip 1.0 --max-len 1024 --clamp 15 \
  --eval-n 256 --log-every 25 --eval-every 100 --seed 0 --save-policy \
  --out "$OUT_DIR/stageB_lora8b_${DIV}_${NORM}_bdpo_token"
echo "=== done 8B LoRA [$DIV, norm=$NORM] | $(date) ==="
